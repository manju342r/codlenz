# Copy to .env for hosted deployments. Never commit .env with real values.
# Public page origin allowed to call the API (exact origin, no wildcard).
CORS_ORIGIN=
# Comma-separated repo roots the web API may scan. Empty = any local path (localhost demo default).
CODELENS_REPO_ALLOWLIST=
# Ollama base URL. Default http://localhost:11434. Keep server-side; never expose to browsers.
OLLAMA_HOST=
