# Copy to .env for hosted deployments. Never commit .env with real values.
# Every default also has a fallback compiled in; see codelens/config.py.

# Exact page origin allowed to call the API (empty = same-origin only).
CORS_ORIGIN=
# Comma-separated repo roots the web API may scan (empty = any local path).
CODELENS_REPO_ALLOWLIST=
# Ollama base URL (server-side only; never expose to browsers).
OLLAMA_HOST=http://localhost:11434
# Model selection.
CODELENS_MODEL=gemma3:4b
CODELENS_FALLBACK_MODEL=qwen2.5:3b
# Serve binding.
CODELENS_HOST=127.0.0.1
CODELENS_PORT=8000
# Timeouts and limits.
CODELENS_MODEL_TIMEOUT=180
CODELENS_CLONE_TIMEOUT=120
CODELENS_MAX_BODY_BYTES=1000000
CODELENS_SCAN_MAX_FILES=500
CODELENS_RETRIEVE_TOP_K=5
