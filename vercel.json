{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "codelens/static",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://multiple-appears-secretary-conventional.trycloudflare.com/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    }
  ]
}
